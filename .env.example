# Copy to a file OUTSIDE the repo (default: ~/.synteel.env) and fill in.
# The server reads SYNTEEL_ENV_FILE if set, otherwise ~/.synteel.env.
# Never commit a filled-in copy. No key is needed to run the app: see SYNTEEL_AI_MOCK below.
# Meta Model API: Muse Spark 1.3, Muse Voice Transcribe and SAM 3.1.
META_API_KEY=
# Optional: Baseten, Muse Spark Open for the two agents and Listen (without it the Meta API runs them).
BASETEN_API_KEY=
# Optional: Fireworks, for the open-weight Muse Spark Open fallback.
FIREWORKS_API_KEY=
# Optional: fireworks puts Muse Spark Open first (voice still uses Meta).
# SYNTEEL_AI_PROVIDER=fireworks
# Optional: cap on real AI reads per day.
# SYNTEEL_AI_DAILY_CAP=150
# Optional
PORT=8787
# Optional: example AI drafts instead of calling the API (no keys needed)
# SYNTEEL_AI_MOCK=1
