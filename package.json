{
  "name": "synteel-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web",
    "admin"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web && npm run build -w admin",
    "check:meta": "node scripts/check-meta-api.ts",
    "test": "npm test -w server",
    "seed:demo": "node scripts/seed-demo.ts --reset",
    "eval": "node scripts/eval.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2"
  }
}
